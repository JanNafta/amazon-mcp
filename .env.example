# Amazon Associates tracking tags per marketplace.
# Sign up at https://affiliate-program.amazon.com/ (one program per marketplace).
# Format: yourname-XX (where XX is 20 for US, 21 for ES, etc.)
# Leave blank to use the PLACEHOLDER tag (links still work, but you earn nothing).

AMAZON_ASSOCIATE_TAG_US=
AMAZON_ASSOCIATE_TAG_ES=
AMAZON_ASSOCIATE_TAG_UK=
AMAZON_ASSOCIATE_TAG_DE=
AMAZON_ASSOCIATE_TAG_FR=
AMAZON_ASSOCIATE_TAG_IT=
AMAZON_ASSOCIATE_TAG_CA=
AMAZON_ASSOCIATE_TAG_JP=
AMAZON_ASSOCIATE_TAG_MX=
AMAZON_ASSOCIATE_TAG_IN=
AMAZON_ASSOCIATE_TAG_BR=
AMAZON_ASSOCIATE_TAG_AU=

# Default marketplace if not specified per call (US|ES|UK|DE|FR|IT|CA|JP|MX|IN|BR|AU)
AMAZON_DEFAULT_MARKETPLACE=US

# Cache TTL in seconds (default 1h for products, 6h for price history)
AMAZON_CACHE_TTL_PRODUCT=3600
AMAZON_CACHE_TTL_PRICE_HISTORY=21600
AMAZON_CACHE_TTL_DEALS=900

# Path to SQLite cache (default ~/.amazon-mcp/cache.db)
# AMAZON_CACHE_DB_PATH=
